[@@@ocamlformat "break-infix-before-func=false"]

let foo = match foo with 1 -> bar >>= ( function _ -> () ) | other -> ()

let foo =
  match foo with
  | 1 -> bar >>= ( function a -> fooooo | b -> fooooo | _ -> () )
  | other -> ()

