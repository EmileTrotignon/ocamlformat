let f = function
  | Foo -> bar
  | EArr l ->
      EArr
        begin
          List.map l
            ~f:
              begin function
              | ElementHole -> ElementHole
              | Element e -> Element (m#expression e)
              | ElementSpread e -> ElementSpread (m#expression e)
              end
        end
