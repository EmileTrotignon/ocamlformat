open struct
  [@@@ocamlformat "let-binding-deindent-fun=true"]

  let _ =
    let _ = function
      | Partial _ -> begin
        fun {target} ->
          match target with
          | Lazy key -> Val_ref.of_key key
          | Lazy_loaded {v_ref; _} | Dirty {v_ref; _} -> v_ref
      end
    in
    ()

  let _ = function
    | Partial _ -> begin
      fun {target} ->
        match target with
        | Lazy key -> Val_ref.of_key key
        | Lazy_loaded {v_ref; _} | Dirty {v_ref; _} -> v_ref
    end
end

