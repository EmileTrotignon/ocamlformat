let compare = function
  | Eq -> ( = )
  | Neq -> ( <> )
  | Lt -> ( < ) [@attr]
  | Le -> ( <= )
  | Gt -> ( > )
  | Ge -> ( >= )

let raise fmt =
  Fmt.kstr
    begin fun error_message (result : _ result) ->
      match result with
      | Ok v -> v
      | Error `Oh_no -> invalid_arg error_message
    end
    fmt

let raise fmt =
  Fmt.kstr
    begin fun error_message
      aaaaaaaaaaaaaaaaaaaaaaaaaaaa
      bbbbbbbbbbbbbbbbbbbbb
    -> invalid_arg error_message
    end
    fmt

